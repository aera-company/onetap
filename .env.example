# Supabase is optional during local visual development.
SUPABASE_URL=
# Preferred server-only key format: sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy JWT key, supported only as a fallback.
SUPABASE_SERVICE_ROLE_KEY=

# Used when generating absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protected admin access. Keep all three server-side only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
