# Supabase is optional during local visual development, but required for the
# admin panel — administrator accounts live in the database.
SUPABASE_URL=
# Preferred server-only key format: sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy JWT key, supported only as a fallback.
SUPABASE_SERVICE_ROLE_KEY=

# Used for absolute metadata URLs, NFC URLs and QR Codes.
# Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: makes "/" redirect to a specific public profile.
# When unset, "/" redirects to the admin panel.
NEXT_PUBLIC_DEFAULT_PROFILE_SLUG=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Administrator accounts are created with: npm run create-admin
ADMIN_SESSION_SECRET=

# Salts the IP hash used for rate limiting the public endpoints.
# Optional: falls back to ADMIN_SESSION_SECRET. Without either, rate limiting
# is skipped. Generate with: openssl rand -base64 32
IP_HASH_SALT=
