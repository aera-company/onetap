{
  "name": "one-tap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-admin.mjs",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "^15.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^24.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
